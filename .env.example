# Copy to .env; never commit API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=240
OPENAI_MAX_OUTPUT_TOKENS=32768
# Evaluation token budgets; set within the selected model's documented limits.
OPENAI_MAX_INPUT_TOKENS=240000
OPENAI_CONTEXT_WINDOW=272768
OPENAI_MAX_CALLS=18

# Optional S3 adapter settings for explicit RefreshService assembly.
# The evaluation CLI and FastAPI do not select S3 from these values.
GRAPHRAG_S3_BUCKET=
GRAPHRAG_S3_INPUT_BUCKET=
GRAPHRAG_S3_PREFIX=refresh
GRAPHRAG_S3_INPUT_PREFIX=refresh
GRAPHRAG_S3_MAX_OBJECT_BYTES=16777216
# Credentials come from the standard AWS credential chain.
AWS_REGION=ap-northeast-2

# Outgoing Content HTTP calls in neptune_refresh_service (not the evaluation CLI).
# Set a service origin, e.g. http://content-api inside the cluster.
CONTENT_BASE_URL=
CONTENT_TIMEOUT_SECONDS=10
# user_id comes from the trusted caller for each execution, never an env var.
