# Copy to .env; never commit API keys.
OPENAI_API_KEY=
# Model for evaluation and Kafka refresh; required when refresh processing is enabled.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=240
OPENAI_MAX_OUTPUT_TOKENS=32768
# Evaluation token budgets; set within the selected model's documented limits.
OPENAI_MAX_INPUT_TOKENS=240000
OPENAI_CONTEXT_WINDOW=272768
OPENAI_MAX_CALLS=18

# S3 settings for explicit assembly and enabled Kafka refresh processing.
# The evaluation CLI remains fake unless explicitly configured.
GRAPHRAG_S3_BUCKET=
GRAPHRAG_S3_INPUT_BUCKET=
GRAPHRAG_S3_PREFIX=refresh
GRAPHRAG_S3_INPUT_PREFIX=refresh
GRAPHRAG_S3_MAX_OBJECT_BYTES=16777216
# Credentials come from the standard AWS credential chain.
AWS_REGION=ap-northeast-2

# Outgoing Content HTTP calls in neptune_refresh_service (not the evaluation CLI).
# Set a service origin, e.g. http://content-api inside the cluster.
CONTENT_BASE_URL=
CONTENT_TIMEOUT_SECONDS=10
# user_id comes from the trusted caller for each execution, never an env var.

# Start fake Kafka polling with FastAPI's lifespan. GitOps enables this in deploys.
# Fake mode only accepts sandbox topics and graph-rag-fake-* consumer groups.
KAFKA_POLLING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_POLLING_TOPICS=graph-rag.sandbox.polling
KAFKA_POLLING_GROUP_ID=graph-rag-fake-polling

# Business Kafka processing (mutually exclusive with fake polling).
KAFKA_PROJECT_CHANGED_ENABLED=false
KAFKA_REFRESH_REQUESTED_ENABLED=false
KAFKA_SHUTDOWN_SECONDS=360
KAFKA_REFRESH_TASK_SECONDS=600
